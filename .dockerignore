# The build stage builds from the SOURCES (Dockerfile): send the repo, minus build output
# (a stale dist/ must never reach the image), installed modules, git metadata and IDE files.
node_modules/
dist/
coverage/
target/
.git
.gitea/
.idea/
.vscode/
# vite bakes VITE_* values from .env files into dist/ — a developer's local one must not ship.
.env*
.claude/
*.iml
.flattened-pom.xml

# The release zip CI downloads for Dockerfile.runtime (publish-image job). The image takes the
# unpacked copy from image-ctx/, so the zip itself must never enter the build context.
release-archives/
